# ==============================================================================
# CONVOZA - Production & Development Environment Configuration
# ==============================================================================

# Application Information
NODE_ENV=development
APP_NAME=CONVOZA
APP_TAGLINE="Conversations. Connected."
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1

# Frontend Applications URLs
WEBSITE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# PostgreSQL Database (PgBouncer-compatible, connection pooling)
DATABASE_URL="postgresql://convoza_user:convoza_secure_password_2026@localhost:5432/convoza_db?schema=public&connection_limit=30&pool_timeout=20"
DIRECT_URL="postgresql://convoza_user:convoza_secure_password_2026@localhost:5432/convoza_db?schema=public"

# Authentication & Security
JWT_SECRET=super-secret-convoza-jwt-access-token-key-2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super-secret-convoza-refresh-token-rotation-key-2026
REFRESH_TOKEN_EXPIRATION=7d
CREDENTIALS_ENCRYPTION_KEY=convoza-super-secret-master-key-32b

# Meta WhatsApp Business Platform (Cloud API & Embedded Signup)
META_GRAPH_API_VERSION=v20.0
META_APP_ID=4558736907726599
META_APP_SECRET=0123456789abcdef0123456789abcdef
META_CONFIG_ID=
META_HOSTED_ES_URL=
META_WEBHOOK_VERIFY_TOKEN=convoza_meta_verify_token_secure_2026
META_SYSTEM_USER_ACCESS_TOKEN=EAAG...PLACEHOLDER_TOKEN

# Razorpay Subscriptions & Payments
RAZORPAY_KEY_ID=rzp_test_convoza_key_id
RAZORPAY_KEY_SECRET=rzp_test_convoza_key_secret
RAZORPAY_WEBHOOK_SECRET=convoza_razorpay_webhook_secret_2026

# Worker & Queue Processing
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1500
CAMPAIGN_BATCH_SIZE=50
MESSAGE_RATE_LIMIT_PER_SEC=50

